# Copy to .env.local. Everything prefixed VITE_ is PUBLIC and ends up in the bundle.
# Never put a secret / service_role key here (the app refuses to start if you do).

# `supabase start` prints both values for local development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key

# Optional teacher-local AI companion (see companion/README.md).
VITE_COMPANION_URL=http://127.0.0.1:8765
